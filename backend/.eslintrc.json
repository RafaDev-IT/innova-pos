{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended", "prettier"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "eqeqeq": ["error", "smart"],
    "prefer-const": "error",
    "no-var": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js", "**/*.test.js"],
      "plugins": ["jest"],
      "env": { "jest": true },
      "extends": ["plugin:jest/recommended"],
      "globals": {
        "resetDatabase": "readonly",
        "createUser": "readonly",
        "apiAs": "readonly",
        "adminUser": "writable",
        "adminToken": "writable"
      },
      "rules": {
        "jest/expect-expect": [
          "warn",
          { "assertFunctionNames": ["expect", "request.**.expect", "apiAs.**.expect", "apiAs().**.expect"] }
        ]
      }
    }
  ],
  "ignorePatterns": ["node_modules/", "coverage/"]
}
