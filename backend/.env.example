# Copiar a `.env` y ajustar según el entorno local.
# Estos valores coinciden con los defaults del docker-compose.yml de la raíz.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=innova_pos
DB_USER=pos_user
DB_PASSWORD=pos_password

# Alternativa para bases gestionadas (Supabase, Neon, Railway…). Si está
# definida tiene prioridad sobre las cinco variables de arriba y activa TLS;
# comentarla vuelve a la base local sin ningún otro cambio.
#
# En Supabase: Project Settings → Database → Connection string. Hay tres
# opciones y solo una sirve:
#
#   ✔ Session pooler      puerto 5432, usuario postgres.<ref>, host
#                         aws-N-<región>.pooler.supabase.com — es esta.
#   ✖ Direct connection   host db.<ref>.supabase.co. Solo resuelve a IPv6, y
#                         el plan gratuito de Render no tiene salida IPv6:
#                         falla con ENETUNREACH.
#   ✖ Transaction pooler  puerto 6543. No admite sentencias preparadas y
#                         rompe las migraciones.
#
# DATABASE_URL=postgresql://postgres.xxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Base de datos usada por la suite de tests (se crea y limpia automáticamente).
DB_NAME_TEST=innova_pos_test

# Orígenes permitidos para CORS, separados por coma. En desarrollo, el dev
# server de Vite. En producción, los dominios del frontend desplegado: Firebase
# Hosting publica el mismo sitio en `.web.app` y en `.firebaseapp.com`, así que
# van los dos.
CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=https://innova-pos.web.app,https://innova-pos.firebaseapp.com

# Secreto de firma de los tokens de sesión. Obligatorio en producción, con
# mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-produccion
# Duración de la sesión. Ocho horas equivale a un turno de caja.
JWT_EXPIRES_IN=8h

# Zona horaria del negocio. Los reportes por hora y los cortes por día se
# calculan sobre ella, no sobre UTC.
BUSINESS_TIMEZONE=America/El_Salvador

# ─── Puesta en marcha en producción ──────────────────────────────────────────
# Solo se usan al ejecutar `npm run db:seed:prod`, que crea el administrador
# inicial. Si INITIAL_ADMIN_PASSWORD se deja vacía, el seeder genera una
# contraseña aleatoria y la imprime una única vez en la consola: anótala en ese
# momento, porque no queda guardada en ningún archivo.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Las semillas de demostración (catálogo, tres usuarios de ejemplo y treinta
# días de ventas simuladas) se niegan a ejecutarse con NODE_ENV=production.
# Para forzarlas en un entorno de capacitación:  ALLOW_DEMO_SEED=yes-i-know
