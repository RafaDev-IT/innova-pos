# Copiar a `.env` y ajustar según el entorno local.
# Estos valores coinciden con los defaults del docker-compose.yml de la raíz.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=innova_pos
DB_USER=pos_user
DB_PASSWORD=pos_password

# Base de datos usada por la suite de tests (se crea y limpia automáticamente).
DB_NAME_TEST=innova_pos_test

# Origen permitido para CORS (el dev server de Vite).
CORS_ORIGIN=http://localhost:5173

# Secreto de firma de los tokens de sesión. Obligatorio en producción, con
# mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-produccion
# Duración de la sesión. Ocho horas equivale a un turno de caja.
JWT_EXPIRES_IN=8h
