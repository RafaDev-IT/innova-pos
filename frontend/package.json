{
  "name": "innova-pos-frontend",
  "version": "1.0.0",
  "description": "SPA del POS básico — Vue.js 2 + Vuetify 2 + Axios",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.vue",
    "lint:fix": "eslint . --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@zxing/browser": "^0.2.1",
    "axios": "^1.7.2",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "vuetify": "^2.7.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/test-utils": "^1.3.6",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.27.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "vue-template-compiler": "^2.7.16"
  }
}
