# Copiar a `.env` (desarrollo) o definir en el panel del proveedor de hosting.
# Vite solo expone al navegador las variables que empiezan por VITE_.

# ─── Desarrollo ──────────────────────────────────────────────────────────────
# Sin definir nada, la aplicación pide a `/api` y el dev server de Vite hace de
# proxy hacia el backend local, así que no hay CORS de por medio.
# Solo hace falta esto si la API local no está en el puerto 3000:
# VITE_API_PROXY_TARGET=http://localhost:3000

# ─── Producción ──────────────────────────────────────────────────────────────
# Ya está definida en `.env.production`, que sí se versiona porque no contiene
# secretos y evita tener que recordar la URL en cada compilación. Esta entrada
# queda como documentación.
#
# En un build estático no existe el proxy de Vite: el navegador llama a la API
# directamente, así que la URL absoluta es obligatoria. Sin ella la aplicación
# pediría a `/api` del propio dominio de hosting y fallaría con 404 —y no al
# compilar, sino al intentar iniciar sesión.
#
# El backend debe declarar el dominio del frontend en su CORS_ORIGIN, y Firebase
# publica el mismo sitio en `.web.app` y en `.firebaseapp.com`: van los dos.
VITE_API_BASE_URL=https://innova-pos.onrender.com/api

# Muestra los atajos de acceso con credenciales de ejemplo en el login.
# Déjalo sin definir en cualquier despliegue real: publicar la contraseña del
# administrador en la pantalla de acceso equivale a no tener autenticación.
# Solo para un entorno de demostración con datos ficticios.
# VITE_SHOW_DEMO_ACCOUNTS=true
